# ============================================================
# OSINT-to-Attack-Path — Environment Variables Template
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
# Mode: "demo" (no API keys needed) or "live" (uses real APIs)
OSINT_MODE=demo

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./osint_attack_path.db

# ── Server ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════
# CORE API KEYS (for Live Mode)
# ═══════════════════════════════════════════════════════════

# GitHub — Free with token. Enables repo search, code search, email discovery.
# Create at: https://github.com/settings/tokens (classic, read:public_repo)
GITHUB_TOKEN=

# Shodan — Free tier limited. Required for IP/ASN/technology intelligence.
# Get at: https://account.shodan.io/
SHODAN_API_KEY=

# VirusTotal — Free tier: 4 req/min. Required for domain/IP/cert threat intel.
# Get at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# Censys — Free community tier. For host/certificate intelligence.
# Get at: https://app.censys.io/register
CENSYS_API_ID=
CENSYS_API_SECRET=

# ═══════════════════════════════════════════════════════════
# EMAIL INTELLIGENCE
# ═══════════════════════════════════════════════════════════

# Hunter.io — Free: 25 requests/month. For domain email enumeration.
# Get at: https://hunter.io/users/sign_up
HUNTER_API_KEY=

# Have I Been Pwned — PAID ($3.50/month). Breach metadata only (no passwords).
# Get at: https://haveibeenpwned.com/API/Key
# OPTIONAL — system works without this key.
HIBP_API_KEY=

# EmailRep.io — Free: 100 req/day. For email reputation (safe metadata only).
# Get at: https://emailrep.io/key
EMAILREP_API_KEY=

# ═══════════════════════════════════════════════════════════
# DNS / SUBDOMAIN (optional)
# ═══════════════════════════════════════════════════════════

# SecurityTrails — optional, for extended passive DNS.
# Get at: https://securitytrails.com/app/signup
SECURITYTRAILS_API_KEY=

# DNSDumpster — optional API key for bulk queries.
DNSDUMPSTER_API_KEY=

# ═══════════════════════════════════════════════════════════
# FIREBASE (optional — sync layer)
# ═══════════════════════════════════════════════════════════

# Firebase project credentials (frontend SDK)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK — path to service account JSON for backend sync
# Download from: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=

# ═══════════════════════════════════════════════════════════
# CONFIDENCE SCORING (configurable — leave blank for defaults)
# ═══════════════════════════════════════════════════════════

# Source agreement bonus per additional source (default: 0.08)
# CONFIDENCE_SOURCE_BONUS=0.08

# Maximum bonus from source agreement (default: 0.30)
# CONFIDENCE_MAX_BONUS=0.30

# Days after which data is considered stale (default: 30)
# CONFIDENCE_FRESHNESS_DAYS=30

# Bonus for recent/fresh data (default: 0.05)
# CONFIDENCE_FRESHNESS_BONUS=0.05
