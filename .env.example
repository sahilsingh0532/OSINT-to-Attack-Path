# OSINT-to-Attack-Path Configuration
# Copy this file to .env and configure

# Application Mode: "demo" or "live"
OSINT_MODE=demo

# Database
DATABASE_URL=sqlite+aiosqlite:///./osint_attack_path.db

# API Keys (only needed for live mode)
GITHUB_TOKEN=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=  

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
